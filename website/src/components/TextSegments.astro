---
import { headingPhrases } from '../typography/chinese-text.ts';
import type { Language } from '../i18n.ts';

interface Props {
  text: string;
  lang?: Language;
}

const { text, lang = 'en' } = Astro.props;
const phrases = headingPhrases(text, lang);
---

{phrases.map((phrase, index) => (
  <Fragment>
    {index > 0 && <wbr data-phrase-break />}
    {phrase}
  </Fragment>
))}
