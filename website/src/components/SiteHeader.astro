---
import logo from '../assets/pluvy-natural-neck.svg';
import { basePath, docsPath, headerContent, type Language } from '../i18n.ts';

interface Props {
  landing?: boolean;
  languagePicker?: boolean;
  lang?: Language;
}

const { landing = false, languagePicker = false, lang = 'en' } = Astro.props;
const content = headerContent[lang];
const base = basePath();
const languageHref = lang === 'zh-CN' ? base : `${base}zh/`;
const languageLabel = lang === 'zh-CN' ? 'EN' : '中文';
const languageAria = lang === 'zh-CN' ? 'Switch to English' : '切换到简体中文';
---

<header class="site-header">
  <div class:list={['site-header__inner', { 'landing-shell': landing }]}>
    <a class="brand" href={lang === 'zh-CN' ? `${base}zh/` : base} aria-label={lang === 'zh-CN' ? 'Pluvy 首页' : 'Pluvy home'}>
      <img src={logo.src} width="44" height="44" alt="" />
      <span>PLUVY</span>
    </a>
    <nav class="site-nav" aria-label={content.navigation}>
      <a href={`${base}${docsPath(lang)}/getting-started/`} data-truncate>{content.docs}</a>
      <a href={`${base}blog/`} data-truncate>{content.blog}</a>
      <a href="https://github.com/sectrend-cn/pluvy" rel="external" data-truncate>GitHub <span aria-hidden="true">↗</span></a>
      {languagePicker && (
        <a class="language-switch" href={languageHref} hreflang={lang === 'zh-CN' ? 'en' : 'zh-CN'} lang={lang === 'zh-CN' ? 'en' : 'zh-CN'} aria-label={languageAria} data-truncate>
          {languageLabel}
        </a>
      )}
      <button class="theme-toggle" type="button" data-theme-toggle aria-label={content.theme} aria-pressed="false" title={content.theme}>
        <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
          <path d="M20 15.5A8.5 8.5 0 0 1 8.5 4 8.5 8.5 0 1 0 20 15.5Z" />
        </svg>
        <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
          <circle cx="12" cy="12" r="3.5" />
          <path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4" />
        </svg>
      </button>
    </nav>
  </div>
</header>

<script>
  type Theme = 'light' | 'dark';

  const themeToggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');

  function readTheme(): Theme | null {
    try {
      const value = localStorage.getItem('pluvy-theme');
      return value === 'dark' || value === 'light' ? value : null;
    } catch {
      return null;
    }
  }

  function currentTheme(): Theme {
    return document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
  }

  function applyTheme(theme: Theme, persist = false): void {
    document.documentElement.dataset.theme = theme;
    document.querySelector('meta[name="theme-color"]')?.setAttribute('content', theme === 'dark' ? '#111210' : '#f8faf8');
    if (persist) {
      try { localStorage.setItem('pluvy-theme', theme); } catch {}
    }
    if (themeToggle) {
      const next = theme === 'dark' ? 'light' : 'dark';
      const label = document.documentElement.lang === 'zh-CN'
        ? theme === 'dark' ? '切换到浅色模式' : '切换到深色模式'
        : `Switch to ${next} theme`;
      themeToggle.setAttribute('aria-label', label);
      themeToggle.setAttribute('aria-pressed', String(theme === 'dark'));
      themeToggle.title = label;
    }
  }

  if (themeToggle) {
    themeToggle.addEventListener('click', () => applyTheme(currentTheme() === 'dark' ? 'light' : 'dark', true));
    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (event) => {
      if (readTheme() === null) applyTheme(event.matches ? 'dark' : 'light');
    });
    applyTheme(currentTheme());
  }
</script>

<style>
  .site-header {
    position: relative;
    z-index: 20;
    border-bottom: 1px solid var(--line);
    background: var(--paper);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 6rem;
  }

  .site-header__inner:not(.landing-shell) {
    width: min(100%, 1440px);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    font-family: var(--sans);
    font-size: 0.95rem;
    font-weight: 650;
    letter-spacing: 0.22em;
    text-decoration: none;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .brand img {
    width: 2.75rem;
    height: 2.75rem;
    object-fit: contain;
  }

  .site-nav {
    display: flex;
    align-items: center;
    min-width: 0;
    gap: clamp(1.2rem, 3vw, 2.8rem);
    font-family: var(--mono);
    font-size: 0.72rem;
    font-weight: 600;
  }

  .theme-toggle {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 4px;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
    transition: background-color 160ms ease, border-color 160ms ease;
  }

  .theme-toggle:hover {
    background: var(--accent-soft);
  }

  .theme-toggle svg {
    width: 1rem;
    height: 1rem;
  }

  .theme-toggle .sun {
    display: none;
  }

  :global(html[data-theme='dark']) .theme-toggle .sun {
    display: block;
  }

  :global(html[data-theme='dark']) .theme-toggle .moon {
    display: none;
  }

  .site-nav a {
    position: relative;
    margin: -0.8rem -0.4rem;
    padding: 0.8rem 0.4rem;
    text-decoration: none;
  }

  .theme-toggle {
    position: relative;
  }

  .theme-toggle::before {
    position: absolute;
    inset: -0.35rem;
    content: '';
  }

  .site-nav a::after {
    position: absolute;
    right: 0.4rem;
    bottom: 0.3rem;
    left: 0.4rem;
    height: 1px;
    background: currentColor;
    content: '';
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 160ms ease;
  }

  .site-nav a:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  @media (max-width: 540px) {
    .site-header__inner {
      min-height: 5rem;
    }

    .brand {
      gap: 0.45rem;
      font-size: 0.75rem;
    }

    .brand img {
      width: 2.25rem;
      height: 2.25rem;
    }

    .site-nav {
      gap: 0.9rem;
    }
  }

  @media (max-width: 380px) {
    .brand span {
      display: none;
    }
  }
</style>
