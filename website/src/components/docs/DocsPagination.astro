---
import DocsMobileNav from './DocsMobileNav.astro';
import { basePath } from '../../i18n.ts';

const { dir, lang, pagination } = Astro.locals.starlightRoute;
const { prev, next } = pagination;
const isRtl = dir === 'rtl';
const zh = lang.startsWith('zh');
const base = basePath();
const homeHref = zh ? `${base}zh/` : base;
const copy = {
  helpTitle: zh ? '遇到问题？' : 'Still need help?',
  openIssue: zh ? '提交 Issue' : 'Open an issue',
  falsePositive: zh ? '报告误报' : 'Report a false positive',
  previous: zh ? '上一页' : 'Previous',
  next: zh ? '下一页' : 'Next',
  home: zh ? '首页' : 'Home',
};
---

<aside class="docs-help" aria-labelledby="docs-help-title">
  <h2 id="docs-help-title">{copy.helpTitle}</h2>
  <div class="docs-help__links">
    <a href="https://github.com/sectrend-cn/pluvy/issues">{copy.openIssue}</a>
    <a href="https://github.com/sectrend-cn/pluvy/issues/new?template=false-positive.md">{copy.falsePositive}</a>
  </div>
</aside>

<div class="pagination-links print:hidden" dir={dir}>
  {!prev && <a href={homeHref} rel="prev">
    <span aria-hidden="true">{isRtl ? '→' : '←'}</span>
    <span>{copy.previous}<br /><span class="link-title">{copy.home}</span></span>
  </a>}
  {prev && <a href={prev.href} rel="prev">
    <span aria-hidden="true">{isRtl ? '→' : '←'}</span>
    <span>{copy.previous}<br /><span class="link-title">{prev.label}</span></span>
  </a>}
  {next && <a href={next.href} rel="next">
    <span>{copy.next}<br /><span class="link-title">{next.label}</span></span>
    <span aria-hidden="true">{isRtl ? '←' : '→'}</span>
  </a>}
</div>

<DocsMobileNav />

<style>
  .docs-help {
    margin-bottom: 1.5rem;
    padding: 1.25rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
  }

  .docs-help h2 {
    margin: 0 0 0.75rem;
    font-size: var(--sl-text-lg);
  }

  .docs-help__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
  }

  .pagination-links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(18rem, 100%), 1fr));
    gap: 1rem;
  }

  .pagination-links a {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    padding: 1rem;
    color: var(--sl-color-gray-2);
    box-shadow: var(--sl-shadow-md);
    overflow-wrap: anywhere;
    text-decoration: none;
  }

  .pagination-links a:hover {
    border-color: var(--sl-color-gray-2);
  }

  .pagination-links [rel='next'] {
    justify-content: end;
    text-align: end;
  }

  .link-title {
    color: var(--sl-color-white);
    font-size: var(--sl-text-2xl);
    line-height: var(--sl-line-height-headings);
  }
</style>

<script>
  import './docs-navigation.ts';
</script>
