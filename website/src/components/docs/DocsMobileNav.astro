---
import SidebarSublist from '@astrojs/starlight/components/SidebarSublist.astro';
import DocsTocList from './DocsTocList.astro';

const { lang, sidebar, toc } = Astro.locals.starlightRoute;
const zh = lang.startsWith('zh');
const copy = {
  overview: zh ? '概览' : 'Overview',
  navigation: zh ? '文档导航' : 'Documentation navigation',
  pages: zh ? '文档目录' : 'Pages',
  pagesSheet: zh ? '文档页面列表' : 'Documentation pages',
  outlineSheet: zh ? '本页目录' : 'On this page',
  close: zh ? '关闭' : 'Close',
};
const currentSection = toc?.items[0]?.text ?? copy.overview;
---

<nav class="docs-mobile-nav" aria-label={copy.navigation}>
  <button type="button" data-docs-open="pages" aria-controls="docs-sheet-pages">{copy.pages}</button>
  <button type="button" data-docs-open="outline" aria-controls="docs-sheet-outline">
    <span data-current-section data-truncate>{currentSection}</span>
  </button>
</nav>

<dialog id="docs-sheet-pages" class="docs-sheet" data-docs-sheet aria-label={copy.pagesSheet}>
  <div class="docs-sheet__header">
    <strong>{copy.pages}</strong>
    <button type="button" data-docs-close aria-label={copy.close}>×</button>
  </div>
  <div class="docs-sheet__body"><SidebarSublist sublist={sidebar} /></div>
</dialog>

{toc && (
  <dialog id="docs-sheet-outline" class="docs-sheet" data-docs-sheet aria-label={copy.outlineSheet}>
    <div class="docs-sheet__header">
      <strong>{copy.outlineSheet}</strong>
      <button type="button" data-docs-close aria-label={copy.close}>×</button>
    </div>
    <div class="docs-sheet__body"><DocsTocList items={toc.items} /></div>
  </dialog>
)}
