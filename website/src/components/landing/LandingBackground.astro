<div class="landing-background" aria-hidden="true" data-dot-matrix>
  <canvas data-layer="animation"></canvas>
</div>

<script>
  const container = document.querySelector<HTMLElement>('[data-dot-matrix]');
  if (container) {
    const { startDotMatrix } = await import('./dot-matrix');
    startDotMatrix(container);
  }
</script>

<style>
  .landing-background {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .landing-background canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .landing-background[data-unavailable='true'] canvas {
    display: none;
  }
</style>
