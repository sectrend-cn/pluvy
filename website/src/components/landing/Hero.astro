---
import { docsPath, landingContent, type Language } from '../../i18n.ts';
import TextSegments from '../TextSegments.astro';

interface Props {
  lang?: Language;
}

const { lang = 'en' } = Astro.props;
const content = landingContent[lang].hero;
const base = `${import.meta.env.BASE_URL}/`;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__content shell">
    <h1 id="hero-title">
      <TextSegments text={content.lead} lang={lang} />{' '}<br class="hero__break" />
      <em><TextSegments text={content.emphasis} lang={lang} /></em>
    </h1>
    <div class="hero__intro">
      <p>{content.description}</p>
      <div class="hero__actions">
        <a class="button button--primary" href={`${base}${docsPath(lang)}/getting-started/`}>
          {content.getStarted} <span aria-hidden="true">→</span>
        </a>
        <a class="text-link" href="https://github.com/sectrend-cn/pluvy">{content.viewGithub}</a>
      </div>
      <div class="hero__install">
        <div class="hero__command">
          <code data-install-command>uv tool install pluvy</code>
          <button type="button" class="hero__copy" data-copy-install data-copied={content.copied} hidden>{content.copy}</button>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy-install]')) {
    const command = button.parentElement?.querySelector('[data-install-command]');
    if (!command || !navigator.clipboard) continue;
    const label = button.textContent ?? '';
    button.hidden = false;
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(command.textContent ?? '');
        button.textContent = button.dataset.copied ?? label;
      } catch {
        const range = document.createRange();
        range.selectNodeContents(command);
        window.getSelection()?.removeAllRanges();
        window.getSelection()?.addRange(range);
      }
      window.setTimeout(() => { button.textContent = label; }, 1600);
    });
  }
</script>

<style>
  .hero {
    position: relative;
    display: flex;
    min-height: max(100svh, 760px);
    overflow: hidden;
  }

  .hero__content {
    align-self: center;
    padding-top: 9rem;
    padding-bottom: 10rem;
  }

  @keyframes hero-enter {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  h1 {
    max-width: 1040px;
    margin: 0;
    font-size: clamp(3.7rem, 7.25vw, 7rem);
    font-weight: 500;
    letter-spacing: -0.075em;
    line-height: 0.93;
    animation: hero-enter 650ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  h1 em {
    font-family: var(--serif);
    font-weight: 400;
    letter-spacing: -0.06em;
  }

  .hero__intro {
    max-width: 34rem;
    margin-top: 2.5rem;
    animation: hero-enter 650ms 100ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .hero__intro > p {
    margin: 0;
    color: var(--muted);
    font-size: clamp(1rem, 1.3vw, 1.15rem);
    line-height: 1.65;
  }

  .hero__actions {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-top: 1.6rem;
  }

  .hero__install {
    margin-top: 1.75rem;
  }

  .hero__command {
    display: inline-flex;
    align-items: stretch;
    max-width: 100%;
    border: 1px solid var(--line);
    border-radius: 4px;
    background: var(--paper);
    font-family: var(--mono);
    font-size: 0.8rem;
  }

  .hero__command code {
    display: flex;
    align-items: center;
    min-width: 0;
    padding: 0.7rem 0.9rem;
    overflow-x: auto;
    white-space: nowrap;
  }

  .hero__copy {
    min-width: 4.5rem;
    min-height: 2.75rem;
    padding: 0 0.9rem;
    border: 0;
    border-left: 1px solid var(--line);
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-size: 0.72rem;
    cursor: pointer;
  }

  .hero__copy:hover {
    background: var(--accent-soft);
  }

  @media (max-width: 700px) {
    h1:not(:lang(zh)) .hero__break {
      display: none;
    }

    .hero {
      min-height: max(100svh, 800px);
    }

    .hero__content {
      align-self: start;
      padding-top: 8.5rem;
      padding-bottom: 12rem;
    }

    h1 {
      font-size: clamp(3.15rem, 13.8vw, 5.5rem);
      line-height: 0.96;
    }

    h1:lang(zh) {
      font-size: clamp(2.2rem, 10vw, 4.5rem);
      line-height: 1.12;
    }

    .hero__intro {
      margin-top: 2rem;
    }

  }

  @media (prefers-reduced-motion: reduce) {
    h1,
    .hero__intro {
      animation: none;
    }
  }

  @media (max-width: 420px) {
    .hero__actions {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
