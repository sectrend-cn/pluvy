---
import { basePath, docsPath, landingContent, type Language } from '../../i18n.ts';
import TextSegments from '../TextSegments.astro';
import OptimizationDemo from './OptimizationDemo.astro';
import { formatText } from '../../typography/chinese-text.ts';

interface Props {
  lang?: Language;
}

const { lang = 'en' } = Astro.props;
const content = landingContent[lang].hero;
const base = basePath();
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__layout landing-shell">
    <div class="hero__content legible">
      <h1 id="hero-title">
        <TextSegments text={content.lead} lang={lang} />{' '}<br class="hero__break" />
        <em>{content.emphasis.split('Pluvy').map((part, index) => <Fragment>{index > 0 && <strong class="hero__brand">Pluvy</strong>}<TextSegments text={part} lang={lang} /></Fragment>)}</em>
      </h1>
      <div class="hero__intro">
        <p data-zh-prose={lang === 'zh-CN'}>{formatText(content.description, lang)}</p>
        <div class="hero__actions">
          <a class="button button--primary" href={`${base}${docsPath(lang)}/getting-started/`}>
            {content.getStarted} <span aria-hidden="true">→</span>
          </a>
          <a class="text-link" href="https://github.com/sectrend-cn/pluvy">{content.viewGithub}</a>
        </div>
        <div class="hero__install">
          <span class="hero__install-label">{content.install}</span>
          <div class="hero__command">
            <span class="hero__prompt" aria-hidden="true">$</span>
            <code data-install-command>uv tool install pluvy</code>
            <button type="button" class="hero__copy" data-copy-install data-copied={content.copied} hidden>{content.copy}</button>
          </div>
        </div>
      </div>
    </div>
    <div class="hero__demo">
      <OptimizationDemo lang={lang} />
    </div>
  </div>
</section>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy-install]')) {
    const command = button.parentElement?.querySelector('[data-install-command]');
    if (!command || !navigator.clipboard) continue;
    const label = button.textContent ?? '';
    button.hidden = false;
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(command.textContent ?? '');
        button.textContent = button.dataset.copied ?? label;
      } catch {
        const range = document.createRange();
        range.selectNodeContents(command);
        window.getSelection()?.removeAllRanges();
        window.getSelection()?.addRange(range);
      }
      window.setTimeout(() => { button.textContent = label; }, 1600);
    });
  }
</script>

<style>
  .hero {
    position: relative;
    overflow: hidden;
  }

  .hero__layout {
    display: grid;
    grid-template-columns: var(--landing-columns);
    grid-template-areas: 'demo content';
    align-items: start;
    align-content: start;
    gap: var(--landing-gap);
    min-height: clamp(640px, calc(100svh - 96px), 1040px);
    padding-block: clamp(56px, 8svh, 112px);
  }

  .hero__content,
  .hero__demo {
    min-width: 0;
  }

  .hero__demo {
    grid-area: demo;
    width: 100%;
  }

  .hero__content {
    grid-area: content;
  }

  @keyframes hero-enter {
    from { opacity: 0; transform: translateY(18px); }
    to { opacity: 1; transform: translateY(0); }
  }

  h1 {
    margin: -0.08em 0 0;
    font-size: clamp(56px, 4.3vw, 96px);
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 1.04;
    animation: hero-enter 650ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  h1 em {
    font: inherit;
    color: inherit;
    letter-spacing: inherit;
  }

  .hero__brand {
    color: var(--accent);
    font-family: var(--serif);
    font-style: italic;
    font-weight: 600;
    letter-spacing: -0.055em;
  }

  .hero__intro {
    margin-top: 32px;
    animation: hero-enter 650ms 100ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .hero__intro > p {
    max-width: 52ch;
    margin: 0;
    color: var(--muted);
    font-size: clamp(16px, 0.95vw, 22px);
    line-height: 1.65;
  }

  .hero__actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 24px;
    margin-top: 32px;
  }

  .hero__actions .button,
  .hero__actions .text-link {
    font-size: 14px;
  }

  .hero__install {
    width: fit-content;
    max-width: 100%;
    margin-top: 28px;
  }

  .hero__install-label {
    display: block;
    margin-bottom: 8px;
    color: var(--muted);
    font-size: 12px;
    font-weight: 500;
  }

  .hero__command {
    --command-inset: 6px;
    --copy-radius: 2px;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: var(--command-inset);
    border: 1px solid #3d4439;
    border-radius: calc(var(--copy-radius) + var(--command-inset) + 1px);
    background: #20261f;
    color: #f1f4eb;
    font-family: var(--mono);
  }

  .hero__prompt {
    padding-left: 8px;
    color: #b9d78c;
    font-size: 15px;
    font-weight: 500;
    user-select: none;
  }

  .hero__command code {
    min-width: 0;
    padding-block: 8px;
    overflow-x: auto;
    color: inherit;
    font-size: clamp(13px, 1vw, 16px);
    white-space: nowrap;
  }

  .hero__copy {
    flex: none;
    min-width: 64px;
    min-height: 36px;
    padding: 8px 12px;
    border: 1px solid #68725e;
    border-radius: var(--copy-radius);
    background: #36412e;
    color: #eef5e5;
    font: 500 12px var(--mono);
    cursor: pointer;
    transition: background-color 160ms ease;
  }

  .hero__copy:hover {
    background: #48583c;
  }

  .hero__copy:focus-visible {
    outline-color: #b9d78c;
    outline-offset: 3px;
  }

  @media (min-width: 1800px) {
    .hero__actions .button {
      padding: 20px 32px;
      font-size: 16px;
    }

    .hero__actions .text-link {
      font-size: 16px;
    }
  }

  @media (min-width: 1100px) and (max-height: 800px) {
    .hero__layout {
      min-height: 0;
      padding-block: 48px;
    }

    .hero__intro,
    .hero__actions {
      margin-top: 24px;
    }
  }

  @media (max-width: 1099px) {
    .hero__layout {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'content' 'demo';
      min-height: 0;
      padding-block: 56px;
      gap: 48px;
    }

    h1 {
      max-width: 740px;
      font-size: clamp(56px, 7.2vw, 76px);
    }

    .hero__intro {
      max-width: 58ch;
    }

    .hero__demo {
      max-width: 600px;
    }

    .hero__intro > p {
      font-size: 17px;
    }
  }

  @media (max-width: 767px) {
    .hero__layout {
      padding-block: 40px;
      gap: 32px;
    }

    h1 {
      font-size: clamp(36px, 10.7vw, 54px);
      line-height: 1.06;
    }

    h1:lang(zh) {
      font-size: clamp(35.2px, 10vw, 54px);
      line-height: 1.12;
    }

    h1:not(:lang(zh)) .hero__break {
      display: none;
    }

    .hero__intro,
    .hero__actions {
      margin-top: 24px;
    }

    .hero__intro > p {
      font-size: 15px;
    }

    .hero__actions {
      gap: 16px;
    }

    .hero__actions .button {
      padding: 14px 18px;
      font-size: 14px;
    }

    .hero__actions .text-link {
      font-size: 14px;
    }

    .hero__command {
      gap: 8px;
    }

    .hero__command code {
      font-size: 12px;
    }

    .hero__copy {
      min-width: 52px;
      padding: 8px;
    }
  }

  @media (max-width: 420px) {
    .hero__actions {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    h1,
    .hero__intro {
      animation: none;
    }

    .hero__copy {
      transition: none;
    }
  }
</style>
