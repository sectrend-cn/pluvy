---
import { landingContent, type Language } from '../../i18n.ts';
import TextSegments from '../TextSegments.astro';

interface Props {
  lang?: Language;
}

const { lang = 'en' } = Astro.props;
const content = landingContent[lang].hero;
const base = `${import.meta.env.BASE_URL}/`;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__content shell">
    <h1 id="hero-title">
      <TextSegments text={content.standards} lang={lang} /><br />
      <TextSegments text={content.enforced} lang={lang} /> <em><TextSegments text={content.withoutRewriting} lang={lang} /></em><br />
      <TextSegments text={content.code} lang={lang} />
    </h1>
    <div class="hero__intro">
      <p>{content.description}</p>
      <div class="hero__actions">
        <a class="button button--primary" href={`${base}docs/getting-started/`}>
          {content.getStarted} <span aria-hidden="true">→</span>
        </a>
        <a class="text-link" href="https://github.com/sectrend-cn/pluvy">{content.viewGithub}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    min-height: max(100svh, 760px);
    overflow: hidden;
  }

  .hero__content {
    align-self: center;
    padding-top: 9rem;
    padding-bottom: 10rem;
  }

  @keyframes hero-enter {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  h1 {
    max-width: 1040px;
    margin: 0;
    font-size: clamp(3.7rem, 7.25vw, 7rem);
    font-weight: 500;
    letter-spacing: -0.075em;
    line-height: 0.93;
    animation: hero-enter 650ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  h1 em {
    font-family: var(--serif);
    font-weight: 400;
    letter-spacing: -0.06em;
  }

  .hero__intro {
    max-width: 34rem;
    margin-top: 2.5rem;
    animation: hero-enter 650ms 100ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .hero__intro > p {
    margin: 0;
    color: var(--muted);
    font-size: clamp(1rem, 1.3vw, 1.15rem);
    line-height: 1.65;
  }

  .hero__actions {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-top: 1.6rem;
  }

  @media (max-width: 700px) {
    .hero {
      min-height: max(100svh, 800px);
    }

    .hero__content {
      align-self: start;
      padding-top: 8.5rem;
      padding-bottom: 12rem;
    }

    h1 {
      font-size: clamp(3.15rem, 13.8vw, 5.5rem);
      line-height: 0.96;
    }

    .hero__intro {
      margin-top: 2rem;
    }

  }

  @media (prefers-reduced-motion: reduce) {
    h1,
    .hero__intro {
      animation: none;
    }
  }

  @media (max-width: 420px) {
    .hero__actions {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
