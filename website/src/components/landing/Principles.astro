---
import { landingContent, type Language } from '../../i18n.ts';
import TextSegments from '../TextSegments.astro';

interface Props {
  lang?: Language;
}

const { lang = 'en' } = Astro.props;
const content = landingContent[lang].principles;
---

<section class="principles landing-shell" aria-labelledby="principles-title" data-reveal>
  <div class="principles__heading">
    <h2 id="principles-title" class="display-title"><TextSegments text={content.titleA} lang={lang} />{' '}<br /><em><TextSegments text={content.titleB} lang={lang} /></em></h2>
  </div>
  <ol class="principles__list legible">
    {content.items.map((item) => (
      <li>
        <span>{item.number}</span>
        <h3><TextSegments text={item.title} lang={lang} /></h3>
        <p>{item.before}{item.code && <code>{item.code}</code>}{item.after}</p>
      </li>
    ))}
  </ol>
</section>

<style>
  .principles {
    display: grid;
    grid-template-columns: var(--landing-columns);
    gap: var(--landing-gap);
    padding-block: clamp(4.5rem, 8vw, 8rem);
  }

  h2 em {
    font-family: var(--serif);
    font-weight: 400;
  }

  h2 {
    margin-top: -0.06em;
  }

  .principles__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .principles__list li {
    position: relative;
    padding: 2rem 0 2rem 3.5rem;
    border-top: 1px solid var(--line);
  }

  .principles__list li:last-child {
    border-bottom: 1px solid var(--line);
  }

  .principles__list span {
    position: absolute;
    top: 2.25rem;
    left: 0;
    font-family: var(--mono);
    font-size: 0.7rem;
  }

  h3 {
    margin: 0 0 0.65rem;
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.025em;
  }

  .principles__list p {
    max-width: 65ch;
    margin: 0;
    color: var(--muted);
    font-size: 0.94rem;
  }

  code {
    font-family: var(--mono);
    font-size: 0.85em;
  }

  @media (min-width: 1100px) {
    .principles__list li {
      padding-left: 0;
    }

    .principles__list span {
      left: -2.5rem;
    }
  }
</style>
