---
const capabilities = [
  {
    title: 'Type boundaries',
    body: 'Broad types, unchecked assertions and third-party input or output boundaries.',
  },
  {
    title: 'Architecture',
    body: 'Dependency direction, module placement and explicit ownership.',
  },
  {
    title: 'Usage evidence',
    body: 'Unused parameters, functions, fields and discarded return values.',
  },
  {
    title: 'Function metrics',
    body: 'Lines, statements, complexity, nesting and parameter budgets.',
  },
  {
    title: 'Changed-code audits',
    body: 'Full repository and affected-definition readings for different questions.',
  },
  {
    title: 'CI & agent integration',
    body: 'PyPI CLI, JSON output and the bundled agent skill.',
  },
];
---

<section class="capabilities shell" aria-labelledby="capabilities-title">
  <div class="capabilities__header">
    <h2 id="capabilities-title" class="display-title">The boundaries<br />your codebase<br /><em>depends on.</em></h2>
    <div class="language-note">
      <span>PARSER-BACKED ANALYSIS</span>
      <p>Python / Go / Java / JS / JSX / TS / TSX</p>
    </div>
  </div>
  <ol class="capabilities__grid">
    {capabilities.map((capability, index) => (
      <li>
        <span>{String(index + 1).padStart(2, '0')}</span>
        <h3>{capability.title}</h3>
        <p>{capability.body}</p>
      </li>
    ))}
  </ol>
</section>

<style>
  .capabilities {
    padding-block: clamp(6rem, 11vw, 11rem);
  }

  .capabilities__header {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: end;
    margin-bottom: 5rem;
  }

  h2 em {
    font-family: var(--serif);
    font-weight: 400;
  }

  .language-note {
    padding-bottom: 0.5rem;
    text-align: right;
  }

  .language-note span {
    font-family: var(--mono);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
  }

  .language-note p {
    margin: 0.6rem 0 0;
    color: var(--muted);
    font-size: 0.8rem;
  }

  .capabilities__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--ink);
    border-left: 1px solid var(--line);
    list-style: none;
  }

  .capabilities__grid li {
    min-height: 15rem;
    padding: 1.8rem;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .capabilities__grid span {
    font-family: var(--mono);
    font-size: 0.65rem;
  }

  .capabilities__grid h3 {
    margin: 3rem 0 0.8rem;
    font-size: 1.35rem;
    letter-spacing: -0.03em;
  }

  .capabilities__grid p {
    margin: 0;
    color: var(--muted);
    font-size: 0.9rem;
  }

  @media (max-width: 850px) {
    .capabilities__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 620px) {
    .capabilities__header {
      grid-template-columns: 1fr;
      gap: 2rem;
      margin-bottom: 3rem;
    }

    .language-note {
      text-align: left;
    }

    .capabilities__grid {
      grid-template-columns: 1fr;
    }

    .capabilities__grid li {
      min-height: 0;
    }
  }
</style>
