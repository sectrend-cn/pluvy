---
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<div class="scan-handle">
  <span class="scan-line" aria-hidden="true"></span>
  <span class="scan-knob" aria-hidden="true"><span class="scan-grip"></span></span>
  <input class="scan-range" type="range" min="0" max="100" value="50" aria-label={label} data-code-range />
</div>

<style>
  .scan-handle {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .scan-line {
    position: absolute;
    inset-block: 0;
    left: var(--scan-position);
    width: 2px;
    background: #c4f486;
    box-shadow: 0 0 6px #b9f37b55;
    pointer-events: none;
  }

  .scan-knob {
    position: absolute;
    top: 50%;
    left: clamp(12px, var(--scan-position), calc(100% - 12px));
    display: grid;
    place-items: center;
    width: 22px;
    height: 40px;
    transform: translate(-50%, -50%);
    border: 1px solid #7b8771;
    border-radius: 3px;
    background: linear-gradient(90deg, #aeb9a4, #edf0e7 28%, #ced7c4 72%, #9ba98f);
    box-shadow: inset 0 1px 0 #ffffffb3, inset 0 -1px 0 #5f6c4980, 0 1px 3px #0004;
    transition: filter 120ms ease, box-shadow 80ms ease;
  }

  .scan-grip {
    width: 10px;
    height: 16px;
    background: repeating-linear-gradient(90deg, #6b785f 0 1px, #f4f6ef 1px 2px, transparent 2px 4px);
  }

  .scan-handle:has(.scan-range:hover) .scan-knob {
    filter: brightness(1.06);
  }

  .scan-handle:has(.scan-range:active) .scan-knob {
    filter: brightness(.94);
    box-shadow: inset 0 1px 2px #56624666, 0 1px 1px #0003;
  }

  .scan-handle:has(.scan-range:focus-visible) .scan-knob {
    outline: 2px solid #c4f486;
    outline-offset: 2px;
  }

  .scan-range {
    position: absolute;
    inset: 0 auto 0 -22px;
    width: calc(100% + 44px);
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
    touch-action: pan-y;
    pointer-events: none;
  }

  .scan-range::-webkit-slider-thumb {
    appearance: none;
    width: 44px;
    height: 100%;
    pointer-events: auto;
  }

  .scan-range, .scan-range::-webkit-slider-runnable-track {
    appearance: none;
    height: 100%;
  }

  @media (prefers-reduced-motion: reduce) {
    .scan-knob {
      transition: none;
    }
  }
</style>
