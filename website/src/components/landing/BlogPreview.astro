---
import type { CollectionEntry } from 'astro:content';
import { basePath } from '../../i18n.ts';

interface Props {
  posts: CollectionEntry<'blog'>[];
}

const { posts } = Astro.props;
const base = basePath();
const dateFormat = new Intl.DateTimeFormat('en', { dateStyle: 'medium' });
---

{posts.length > 0 && (
  <section class="journal shell" aria-labelledby="journal-title">
    <div class="journal__header">
      <div>
        <h2 id="journal-title" class="display-title">Notes from<br /><em>the gate.</em></h2>
      </div>
      <a class="text-link" href={`${base}blog/`}>All articles</a>
    </div>
    <div class="journal__posts">
      {posts.map((post) => (
        <article>
          <div class="journal__meta">
            <time datetime={post.data.pubDate.toISOString()}>{dateFormat.format(post.data.pubDate)}</time>
            <span>{post.data.tags.join(' / ')}</span>
          </div>
          <h3><a href={`${base}blog/${post.id}/`}>{post.data.title}</a></h3>
          <p>{post.data.description}</p>
          <a class="text-link" href={`${base}blog/${post.id}/`}>Read article</a>
        </article>
      ))}
    </div>
  </section>
)}

<style>
  .journal {
    padding-bottom: clamp(6rem, 10vw, 10rem);
  }

  .journal__header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    padding-bottom: 3rem;
  }

  h2 em {
    font-family: var(--serif);
    font-weight: 400;
  }

  .journal__posts {
    border-top: 1px solid var(--ink);
  }

  article {
    display: grid;
    grid-template-columns: 10rem 1.2fr 1fr auto;
    gap: 2rem;
    align-items: start;
    padding-block: 2.5rem;
    border-bottom: 1px solid var(--line);
  }

  .journal__meta {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-family: var(--mono);
    font-size: 0.65rem;
    text-transform: uppercase;
  }

  .journal__meta span {
    color: var(--muted);
  }

  h3 {
    margin: 0;
    font-size: 1.5rem;
    letter-spacing: -0.035em;
    line-height: 1.2;
  }

  h3 a {
    text-decoration: none;
  }

  h3 a:hover {
    text-decoration: underline;
  }

  article > p {
    margin: 0;
    color: var(--muted);
    font-size: 0.9rem;
  }

  @media (max-width: 900px) {
    article {
      grid-template-columns: 8rem 1fr;
    }

    article > p,
    article > .text-link {
      grid-column: 2;
    }
  }

  @media (max-width: 600px) {
    .journal__header,
    article {
      align-items: start;
      grid-template-columns: 1fr;
    }

    .journal__header {
      align-items: flex-start;
      flex-direction: column;
    }

    article > p,
    article > .text-link {
      grid-column: auto;
    }
  }
</style>
