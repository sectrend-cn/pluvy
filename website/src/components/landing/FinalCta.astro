---
import { basePath, docsPath, landingContent, type Language } from '../../i18n.ts';
import TextSegments from '../TextSegments.astro';

interface Props {
  lang?: Language;
}

const { lang = 'en' } = Astro.props;
const content = landingContent[lang].final;
const base = basePath();
---

<section class="final-cta" data-reveal>
  <div class="final-cta__inner landing-shell">
    <h2><TextSegments text={content.titleA} lang={lang} />{' '}<br /><em><TextSegments text={content.titleB} lang={lang} /></em></h2>
    <div class="final-cta__actions">
      <a class="button button--acid" href={`${base}${docsPath(lang)}/getting-started/#agent-integration`}>
        {content.connectAgent} <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .final-cta {
    background: transparent;
    color: var(--ink);
  }

  .final-cta__inner {
    padding-block: clamp(4.5rem, 7vw, 7rem);
  }

  h2 {
    margin: 0;
    font-size: clamp(3rem, 7vw, 7rem);
    font-weight: 500;
    letter-spacing: -0.07em;
    line-height: 0.95;
  }

  h2 em {
    color: var(--accent);
    font-family: var(--serif);
    font-weight: 400;
  }

  .final-cta__actions {
    display: flex;
    align-items: center;
    gap: 2rem;
    margin-top: 3.5rem;
  }

  @media (max-width: 560px) {
    .final-cta__actions {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
