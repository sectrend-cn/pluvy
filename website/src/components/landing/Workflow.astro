---
import { landingContent, type Language } from '../../i18n.ts';
import TextSegments from '../TextSegments.astro';

interface Props {
  lang?: Language;
}

const { lang = 'en' } = Astro.props;
const content = landingContent[lang].workflow;
const base = `${import.meta.env.BASE_URL}/`;
const policy = `{
  "version": 2,
  "include": ["src/*"],
  "exclude": [],
  "checkers": {}
}`;
const commands = `pluvy --all
pluvy --base <commit>
pluvy --staged`;
---

<section class="workflow" aria-labelledby="workflow-title" data-reveal>
  <div class="workflow__inner shell">
    <div class="workflow__heading">
      <h2 id="workflow-title" class="display-title"><TextSegments text={content.titleA} lang={lang} /><br /><em><TextSegments text={content.titleB} lang={lang} /></em></h2>
      <a class="text-link" href={`${base}docs/getting-started/`}>{content.guide}</a>
    </div>
    <div class="workflow__evidence">
      <div class="evidence-block">
        <div class="evidence-block__bar"><span>{content.policy}</span><span data-truncate>.pluvy/pluvy.json</span></div>
        <pre><code>{policy}</code></pre>
      </div>
      <div class="evidence-block evidence-block--terminal">
        <div class="evidence-block__bar"><span>{content.run}</span><span data-truncate>{content.chooseScope}</span></div>
        <pre><code><span class="prompt">$</span> {commands}</code></pre>
      </div>
      <div class="exit-codes" aria-label={content.exitCodes}>
        {content.items.map((item) => (
          <div><strong>{item.code}</strong><span>{item.description}</span></div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .workflow {
    border-block: 1px solid var(--line);
    background: transparent;
    color: var(--ink);
  }

  .workflow__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(3rem, 8vw, 8rem);
    padding-block: clamp(4.5rem, 8vw, 7.5rem);
  }

  .workflow__heading {
    align-self: start;
  }

  .workflow__heading .text-link {
    margin-top: 2rem;
  }

  h2 em {
    color: var(--accent);
    font-family: var(--serif);
    font-weight: 400;
  }

  .workflow__evidence {
    min-width: 0;
  }

  .evidence-block {
    overflow: hidden;
    border: 1px solid var(--muted);
    border-radius: 4px;
    background: var(--night);
    color: var(--on-night);
  }

  .evidence-block--terminal {
    margin-top: 1.5rem;
  }

  .evidence-block__bar {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.85rem 1.1rem;
    border-bottom: 1px solid var(--muted);
    color: var(--night-muted);
    font-family: var(--mono);
    font-size: 0.65rem;
    letter-spacing: 0.06em;
  }

  pre {
    max-width: 100%;
    margin: 0;
    overflow-x: auto;
    padding: 1.5rem;
    font-family: var(--mono);
    font-size: clamp(0.7rem, 1.2vw, 0.85rem);
    line-height: 1.8;
    white-space: pre;
  }

  .prompt {
    color: var(--acid);
  }

  .exit-codes {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin-top: 2rem;
  }

  .exit-codes > div {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding-left: 1rem;
    border-left: 1px solid var(--line);
  }

  .exit-codes strong {
    color: var(--accent);
    font-family: var(--mono);
    font-size: 1.5rem;
    font-weight: 400;
  }

  .exit-codes span {
    color: var(--muted);
    font-size: 0.75rem;
  }

  @media (max-width: 850px) {
    .workflow__inner {
      grid-template-columns: 1fr;
      gap: 4rem;
    }
  }

  @media (max-width: 480px) {
    .exit-codes {
      gap: 0.8rem;
    }

    .exit-codes span {
      font-size: 0.65rem;
    }
  }
</style>
