---
import { basePath, docsPath, landingContent, type Language } from '../../i18n.ts';
import TextSegments from '../TextSegments.astro';

interface Props {
  lang?: Language;
}

const { lang = 'en' } = Astro.props;
const content = landingContent[lang].workflow;
const base = basePath();
const policy = `{
  "version": 2,
  "include": ["src/*"],
  "checkers": {
    "function_size": { "lines": 50, "complexity": 10 },
    "architecture.import": {
      "boundaries": [{
        "name": "domain does not depend on adapters",
        "sources": ["src/domain/*"],
        "forbidden_imports": ["adapters", "adapters.*"]
      }]
    }
  }
}`;
const command = 'pluvy --base main';
const output = [
  { kind: 'finding', text: 'src/domain/order.py:3:1: architecture.import: domain does not depend on adapters: forbidden dependency adapters.db' },
  { kind: 'finding', text: 'src/domain/order.py:3:1: architecture.import: domain does not depend on adapters: forbidden dependency adapters.db.save' },
  { kind: 'finding', text: 'src/domain/order.py:6:18: type.annotation: Preserve a concrete contract instead of Any' },
  { kind: 'finding', text: 'src/domain/order.py:6:18: type.broad: Do not erase contracts with typing.Any' },
  { kind: 'summary', text: 'Diagnostic scope: affected_definitions_and_statements.' },
  { kind: 'summary', text: 'Usage reference scope: 2 files.' },
  { kind: 'summary', text: 'Architecture base: 1 files; 4 findings.' },
  { kind: 'exit', text: 'exit 1' },
];
---

<section class="workflow" aria-labelledby="workflow-title" data-reveal>
  <div class="workflow__inner landing-shell">
    <div class="workflow__heading legible">
      <h2 id="workflow-title" class="display-title"><TextSegments text={content.titleA} lang={lang} />{' '}<br /><em><TextSegments text={content.titleB} lang={lang} /></em></h2>
      <ul class="scopes">
        {content.scopes.map((scope) => <li><code>{scope}</code></li>)}
      </ul>
      <a class="text-link" href={`${base}${docsPath(lang)}/getting-started/#running`}>{content.guide}</a>
    </div>
    <div class="workflow__evidence">
      <div class="evidence-block">
        <div class="evidence-block__bar"><span>{content.policy}</span><span data-truncate>.pluvy/pluvy.json</span></div>
        <pre><code>{policy}</code></pre>
      </div>
      <div class="evidence-block evidence-block--terminal">
        <div class="evidence-block__bar"><span>{content.run}</span></div>
        <pre class="terminal-output"><code><span class="line"><span class="prompt">$</span> {command}</span>{output.map((line) => <span class:list={['line', line.kind]}>{line.text}</span>)}</code></pre>
      </div>
    </div>
  </div>
</section>

<style>
  .workflow {
    border-block: 1px solid var(--line);
    background: transparent;
    color: var(--ink);
  }

  .workflow__inner {
    display: grid;
    grid-template-columns: var(--landing-columns);
    gap: var(--landing-gap);
    padding-block: clamp(4.5rem, 8vw, 7.5rem);
  }

  .workflow__heading {
    min-width: 0;
    align-self: start;
  }

  h2 {
    margin-top: -0.06em;
  }

  .workflow__heading .text-link {
    margin-top: 1.2rem;
  }

  .scopes {
    margin: 2.5rem 0 0;
    padding: 0;
    border-top: 1px solid var(--line);
    list-style: none;
  }

  .scopes li {
    padding-block: 0.9rem;
    border-bottom: 1px solid var(--line);
  }

  .scopes code {
    font-family: var(--mono);
    font-size: 0.8rem;
    font-weight: 600;
  }

  h2 em {
    color: var(--accent);
    font-family: var(--serif);
    font-weight: 400;
  }

  .workflow__evidence {
    min-width: 0;
  }

  .evidence-block {
    --evidence-inset: clamp(16px, 1.3vw, 24px);
    position: relative;
    z-index: 1;
    overflow: hidden;
    border: 1px solid var(--muted);
    background: var(--night);
    color: var(--on-night);
  }

  .evidence-block--terminal {
    margin-top: 1.5rem;
  }

  .evidence-block__bar {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.85rem var(--evidence-inset);
    border-bottom: 1px solid var(--muted);
    color: var(--night-muted);
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
  }

  pre {
    max-width: 100%;
    margin: 0;
    overflow-x: auto;
    padding: var(--evidence-inset);
    font-family: var(--mono);
    font-size: clamp(0.7rem, 1.2vw, 0.85rem);
    line-height: 1.8;
    white-space: pre;
  }

  .terminal-output {
    overflow-x: visible;
    white-space: normal;
  }

  .terminal-output .line {
    display: block;
    padding-left: 2ch;
    overflow-wrap: anywhere;
    text-indent: -2ch;
    white-space: pre-wrap;
  }

  .prompt,
  .exit {
    color: var(--acid);
  }

  .summary {
    color: var(--night-muted);
  }

</style>
