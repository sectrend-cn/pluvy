---
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Typography from '../components/Typography.astro';
import { headerContent, type Language } from '../i18n.ts';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  landingHeader?: boolean;
  lang?: Language;
}

const { title, description, landingHeader = false, lang = 'en' } = Astro.props;
const content = headerContent[lang];
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : Astro.url;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f8faf8" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}/favicon.svg`} />
    <title>{title}</title>
    <script is:inline>
      let preference = null;
      try { preference = localStorage.getItem('pluvy-theme'); } catch {}
      const dark = preference ? preference === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
      const theme = dark ? 'dark' : 'light';
      document.documentElement.dataset.theme = theme;
      document.querySelector('meta[name="theme-color"]').setAttribute('content', dark ? '#111210' : '#f8faf8');
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">{content.skip}</a>
    <SiteHeader landing={landingHeader} languagePicker={landingHeader} lang={lang} />
    <main id="main-content">
      <slot />
    </main>
    <SiteFooter lang={lang} landing={landingHeader} />
    <Typography />
  </body>
</html>
