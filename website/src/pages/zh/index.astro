---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/landing/Hero.astro';
import Principles from '../../components/landing/Principles.astro';
import Workflow from '../../components/landing/Workflow.astro';
import FinalCta from '../../components/landing/FinalCta.astro';
import LandingBackground from '../../components/landing/LandingBackground.astro';
import type { Language } from '../../i18n.ts';

const lang: Language = 'zh-CN';
---

<BaseLayout
  title="Pluvy — 面向 Agent 代码的只读策略门禁"
  description="Pluvy 按仓库中提交的策略检查 Agent 写的代码，报告检查结果和退出码。支持 Python、Go、Java、JavaScript 和 TypeScript。"
  landingHeader
  lang={lang}
>
  <div class="landing-page">
    <LandingBackground />
    <div class="landing-content">
      <Hero lang={lang} />
      <Principles lang={lang} />
      <Workflow lang={lang} />
      <FinalCta lang={lang} />
    </div>
  </div>
</BaseLayout>

<style>
  .landing-page {
    position: relative;
    isolation: isolate;
  }

  .landing-content {
    position: relative;
    z-index: 1;
  }
</style>
