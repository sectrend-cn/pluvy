---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = `${import.meta.env.BASE_URL}/`;
---

<BaseLayout title="Page not found — Pluvy" description="The requested Pluvy page does not exist.">
  <section class="not-found shell">
    <h1 class="display-title">Page not found.</h1>
    <p>The address may be incorrect or the page may have moved.</p>
    <div class="not-found__actions">
      <a class="button button--primary" href={base}>Return home <span aria-hidden="true">→</span></a>
      <a class="text-link" href={`${base}docs/getting-started/`}>Open the documentation</a>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    min-height: 70vh;
    padding-block: clamp(5rem, 10vw, 10rem);
  }

  h1 em {
    font-family: var(--serif);
    font-weight: 400;
  }

  .not-found > p {
    margin-top: 2rem;
    color: var(--muted);
  }

  .not-found__actions {
    display: flex;
    align-items: center;
    gap: 2rem;
    margin-top: 2.5rem;
  }

  @media (max-width: 540px) {
    .not-found__actions {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
